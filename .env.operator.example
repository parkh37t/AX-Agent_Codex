# Examples only; no real credentials. Set server secrets in the hosting dashboard.
NODE_ENV=production
PORT=4319
AX_PUBLIC_ORIGIN=https://your-service.onrender.com
# Neon DIRECT (not transaction pooled) PostgreSQL URL; driver enforces verified TLS.
DATABASE_URL=
# Explicit schema migration on startup. Enable only for approved deployment.
AX_DB_MIGRATE=false
AX_OIDC_ISSUER=https://your-identity-provider.example
AX_OIDC_CLIENT_ID=
AX_OIDC_CLIENT_SECRET=
# Exact verified OIDC subject identifiers, comma separated. No automatic public signup.
AX_OIDC_ALLOWED_SUBJECTS=
# Register exact callback: https://your-service.onrender.com/auth/callback
# Confidential OIDC client, authorization code, PKCE S256, client_secret_post, RS256/JWKS.
AX_API_EXECUTION_ENABLED=false
OPENAI_API_KEY=
# Candidate verified in official model docs; confirm access/prices before activation.
AX_API_MODEL=gpt-5.6-luna
AX_INPUT_USD_PER_MILLION=0.20
AX_OUTPUT_USD_PER_MILLION=1.20
